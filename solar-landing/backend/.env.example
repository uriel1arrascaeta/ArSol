# Copia este archivo como .env y completa los valores (nunca subas .env a git).
# En Render, configura estas mismas variables en Environment.

# Base de datos (o usa DATABASE_URL directamente)
DATABASE_URL=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=

# Sesiones del Dashboard: cadena larga y aleatoria
JWT_SECRET_KEY=

# Administrador inicial (solo se usa si todavía no existe)
ADMIN_EMAIL=admin@arsol.com
ADMIN_PASSWORD=

# CORS: dominios permitidos separados por coma
ALLOWED_ORIGINS=

GEMINI_API_KEY=
ISALES_FID=
ISALES_E=
